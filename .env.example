# F1Store Environment Variables
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/f1store?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-generate-with-openssl-rand-base64-32"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# CMS (Contentful or Sanity)
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ACCESS_TOKEN=""
CONTENTFUL_PREVIEW_TOKEN=""

# OR Sanity
SANITY_PROJECT_ID=""
SANITY_DATASET="production"
SANITY_API_TOKEN=""

# Search (Algolia or Meilisearch)
ALGOLIA_APP_ID=""
ALGOLIA_SEARCH_API_KEY=""
ALGOLIA_ADMIN_API_KEY=""

# OR Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Email (Resend or SendGrid)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="F1Store <noreply@f1store.com>"

# Analytics & Monitoring
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
SENTRY_DSN=""
NEXT_PUBLIC_GA_ID=""

# Feature Flags
NEXT_PUBLIC_ENABLE_WISHLIST="true"
NEXT_PUBLIC_ENABLE_REVIEWS="false"