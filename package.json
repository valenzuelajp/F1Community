    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "15.0.0",
    "@types/node": "20.12.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.0",
    "playwright": "1.44.0",
    "prettier": "3.2.0",
    "prisma": "5.13.0",
    "tsx": "4.19.0",
    "typescript": "5.4.0",
    "vitest": "1.6.0"
  }
}